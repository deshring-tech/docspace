# Copy to .env.local for local overrides, or set these in your hosting provider.

# The canonical, public URL of the deployed site (no trailing slash).
# Used for sitemap, robots, canonical tags, Open Graph and structured data.
# Example: https://docspace.app
NEXT_PUBLIC_SITE_URL=http://localhost:4680

# --- Analytics (optional, cookieless, off unless set) ---
# Set your site's data domain to enable privacy-friendly, aggregate analytics.
# Leave blank to disable entirely (no third-party script loads, nothing sent).
# Example: docspace.app
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Analytics script source. Defaults to Plausible cloud. Override for a
# self-hosted Plausible or any compatible endpoint.
# Example: https://plausible.io/js/script.js
NEXT_PUBLIC_ANALYTICS_SRC=

# --- OCR engine assets (optional) ---
# OCR always RUNS locally in the browser; these only control where the
# open-source engine and language models are downloaded from. Leave blank to
# use tesseract.js's defaults, or point them at self-hosted copies for a fully
# offline / no-third-party deployment.
# Example: /tesseract/worker.min.js
NEXT_PUBLIC_TESSERACT_WORKER_PATH=
# Example: /tesseract
NEXT_PUBLIC_TESSERACT_CORE_PATH=
# Example: /tessdata
NEXT_PUBLIC_TESSDATA_URL=
