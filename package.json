{
  "name": "docspace",
  "version": "0.1.0",
  "private": true,
  "description": "DocSpace — the fastest way to finish any document task. A privacy-first, browser-only document workspace: exact-KB compression for exam/form uploads, PDF page tools, universal conversion, and a writable pad that exports to PDF/DOCX/Markdown.",
  "scripts": {
    "dev": "next dev -p 4680",
    "build": "next build",
    "start": "next start -p 4680",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/copy-pdf-worker.mjs"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "docx": "^9.0.2",
    "jszip": "^3.10.1",
    "next": "^15.5.22",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.8.69",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
